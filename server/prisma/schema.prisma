generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum Role {
  USER
  TENANT
}

enum BookingStatus {
  WAITING_PAYMENT
  WAITING_CONFIRMATION
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum AdjustmentType {
  PERCENTAGE
  NOMINAL
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  BOOKING
  PAYMENT
  REVIEW
  SYSTEM
}

//
// USERS
//

model User {
  id             String  @id @default(uuid())
  fullName       String
  email          String  @unique
  password       String?
  phone          String?
  role           Role
  isVerified     Boolean @default(false)
  profilePicture String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  properties         Property[]
  bookings           Booking[]
  reviews            Review[]
  notifications      Notification[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  salesReports       SalesReport[]
}

//
// EMAIL VERIFICATION
//

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//
// RESET PASSWORD
//

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//
// NOTIFICATIONS
//

model Notification {
  id      String           @id @default(uuid())
  userId  String
  type    NotificationType
  title   String
  message String
  isRead  Boolean          @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//
// PROPERTY CATEGORY
//

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]
}

//
// PROPERTY
//

model Property {
  id         String @id @default(uuid())
  tenantId   String
  categoryId String

  name        String
  description String
  city        String
  address     String
  latitude    Float?
  longitude   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  images       PropertyImage[]
  rooms        Room[]
  reviews      Review[]
  salesReports SalesReport[]
}

//
// PROPERTY IMAGES
//

model PropertyImage {
  id         String  @id @default(uuid())
  propertyId String
  imageUrl   String
  isPrimary  Boolean @default(false)

  createdAt DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

//
// ROOMS
//

model Room {
  id         String @id @default(uuid())
  propertyId String

  name        String
  basePrice   Float
  description String
  capacity    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  property       Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  images         RoomImage[]
  availabilities RoomAvailability[]
  peakRates      PeakSeasonRate[]

  bookingRooms   BookingRoom[]
}

//
// ROOM IMAGES
//

model RoomImage {
  id        String  @id @default(uuid())
  roomId    String
  imageUrl  String
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

//
// ROOM AVAILABILITY
//

model RoomAvailability {
  id          String   @id @default(uuid())
  roomId      String
  date        DateTime
  isAvailable Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
}

//
// PEAK SEASON RATE
//

model PeakSeasonRate {
  id     String @id @default(uuid())
  roomId String

  startDate DateTime
  endDate   DateTime

  adjustmentType  AdjustmentType
  adjustmentValue Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

//
// BOOKINGS
//

model Booking {
  id          String @id @default(uuid())
  orderNumber String @unique

  userId String

  checkIn    DateTime
  checkOut   DateTime
  guestCount Int

  totalPrice Float
  status     BookingStatus

  paymentDeadline DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookingRooms BookingRoom[]

  paymentProof PaymentProof?
  review       Review?
  salesReports SalesReport[]
}

//
// BOOKING ROOMS
//

model BookingRoom {
  id String @id @default(uuid())

  bookingId String
  roomId    String

  quantity      Int
  roomCapacity  Int

  pricePerNight Float
  subtotal      Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

//
// PAYMENT PROOF
//

model PaymentProof {
  id        String @id @default(uuid())
  bookingId String @unique

  imageUrl String
  amount   Float

  status PaymentProofStatus @default(PENDING)

  uploadedAt DateTime  @default(now())
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

//
// REVIEWS
//

model Review {
  id         String @id @default(uuid())
  userId     String
  propertyId String
  bookingId  String @unique

  rating  Int
  comment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

//
// SALES REPORTS
//

model SalesReport {
  id String @id @default(uuid())

  tenantId   String
  propertyId String
  bookingId  String

  totalSales Float
  reportDate DateTime

  createdAt DateTime @default(now())

  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
