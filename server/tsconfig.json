{
  "compilerOptions": {
    // ==============================
    // Output
    // ==============================
    "rootDir": "./src",
    "outDir": "./dist",

    // ==============================
    // Module System
    // ==============================
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // ==============================
    // Environment
    // ==============================
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["node"],

    // ==============================
    // Strict Type Checking
    // ==============================
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // ==============================
    // Build
    // ==============================
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // ==============================
    // Module Handling
    // ==============================
    "isolatedModules": true,
    "moduleDetection": "force",

    // ==============================
    // Performance
    // ==============================
    "skipLibCheck": true
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}